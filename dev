#!/usr/bin/env python3
"""Configure/build with Meson + Ninja, then optionally run with argument passthrough."""

import argparse
from pathlib import Path
import os
import shutil
import subprocess
import sys


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        '--profile', choices=['Debug', 'DebugExtra', 'Release'], default='Debug')
    parser.add_argument('command', choices=[
                        'build', 'run', 'test', 'valgrind', 'callgrind', 'lib', 'fuzz'])
    parser.add_argument('args', nargs=argparse.REMAINDER,
                        help='arguments passed to the program')
    options = parser.parse_args()
    args = options.args

    if args[:1] == ['--']:
        args = args[1:]
    if options.command in ('build', 'lib') and args:
        parser.error(f'{options.command} only builds and does not accept program arguments')
    wrapped = options.command in ('valgrind', 'callgrind')
    if wrapped and options.profile == 'DebugExtra':
        parser.error(
            'Valgrind/Callgrind require Debug or Release; ASan is incompatible with Valgrind')
    for program in ['meson', 'ninja'] + (['valgrind'] if wrapped else []):
        if shutil.which(program) is None:
            parser.error(f'{program} is required but was not found on PATH')

    root = Path(__file__).resolve().parent
    build = root / 'build' / options.profile
    target = {'build': 'gradeviewer', 'run': 'gradeviewer', 'lib': 'slowjson',
              'fuzz': 'slowjson-fuzz'}.get(options.command, 'gradeviewer_tests')
    if not (build / 'meson-private' / 'coredata.dat').exists():
        subprocess.run(['meson', 'setup', str(build), str(root), '--backend=ninja',
                        '--native-file', str(root / 'build-support' / (options.profile + '.ini'))],
                       cwd=root, check=True)
    subprocess.run(['meson', 'compile', '-C', str(build),
                   target], cwd=root, check=True)
    if options.command in ('build', 'lib'):
        return 0
    executable = build / (target + ('.exe' if os.name == 'nt' else ''))
    prefix = []
    if options.command == 'valgrind':
        prefix = ['valgrind', '--leak-check=full',
                  '--show-leak-kinds=all', '--error-exitcode=1']
    elif options.command == 'callgrind':
        prefix = ['valgrind', '--tool=callgrind', '--dump-instr=yes',
                  '--callgrind-out-file=' + str(build / 'callgrind.out.%p')]
    return subprocess.run([*prefix, str(executable), *args], cwd=root).returncode


if __name__ == '__main__':
    try:
        sys.exit(main())
    except subprocess.CalledProcessError as error:
        sys.exit(error.returncode)
    except KeyboardInterrupt:
        sys.exit(130)
